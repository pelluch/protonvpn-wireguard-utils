# qBittorrent WebUI settings
QB_URL="http://127.0.0.1:8080"
# Requires qBittorrent 5.2+; generate it in the WebUI under Options → Web UI
QB_API_KEY=""

# The ProtonVPN Gateway
# Obtained from https://protonvpn.com/support/port-forwarding-manual-setup#linux
GATEWAY="10.2.0.1"

# Symmetrical port settings
REQUEST_SYMMETRICAL_PORT=true
SET_QBITTORRENT_PORT=true

# Array of ports to forward
# Format: "PRIVATE_PORT:PROTOCOL"
PORTS_TO_FORWARD=(
)

CLEAR_PORTS=false
