[Unit]
Description=ProtonVPN Port Forwarding Service
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/protonvpn-port-forward start
ExecStopPost=/usr/bin/protonvpn-port-forward stop
Restart=always
StandardOutput=journal
StandardError=journal
SyslogIdentifier=protonvpn-port-forward
RestartPreventExitStatus=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
